# Copy to .env and change what you need. Every value has a $0 default.

# --- The bot behind the Option A chat page ---
# provider: ollama | claude | openai
PROVIDER=ollama
MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# --- The optional LLM judge (check 4) ---
# judge: off | ollama | claude | openai
JUDGE=off
JUDGE_MODEL=llama3.2:3b
# Advisory by default: judge verdicts are suggestions and never block.
# Set to true only for a judge that passed `npm run judge:check`.
JUDGE_CAN_BLOCK=false

# --- What the tests run against ---
# target: local (Option A, this repo's chat page) | shopify (Option B, Weekend 2)
TARGET=local
LOCAL_PORT=3000
# SHOPIFY_STORE_URL=https://your-dev-store.myshopify.com

# Planted traps in the Option A bot: on | off
# "off" gives a clean bot, to show the harness passes it.
TRAPS=on

# Repeat runs per question for the stability check
REPEATS=3

# --- Paid upgrade (optional, never required) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
